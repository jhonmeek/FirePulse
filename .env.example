# Database (PostgreSQL + PostGIS)
POSTGRES_DB=firepulse
POSTGRES_USER=firepulse
POSTGRES_PASSWORD=firepulse_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port defaults to 5433 to avoid conflict with local PostgreSQL on 5432
POSTGRES_HOST_PORT=5433

# Django
DJANGO_SECRET_KEY=dev-only-change-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
API_CACHE_SECONDS=300
HTTP_CACHE_MAX_AGE=60
API_SNAPSHOT_FALLBACK=true
FORCE_SNAPSHOT_FALLBACK=false
FIREPULSE_DOMAIN=localhost

# External NASA APIs (fill locally in .env, never commit real keys)
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=
